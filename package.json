{
  "name": "running-tracker",
  "version": "1.0.0",
  "description": "悦跑圈截图识别跑步里程追踪器",
  "main": "backend/server.js",
  "bin": "backend/server.js",
  "pkg": {
    "scripts": [
      "backend/*.js"
    ],
    "assets": [
      "frontend/**/*",
      "data/**/*",
      "backend/paddle_ocr.py"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build": "pkg . --out-path dist",
    "build:win": "pkg . --targets node18-win-x64 --out-path dist",
    "build:linux": "pkg . --targets node18-linux-x64 --out-path dist",
    "build:mac": "pkg . --targets node18-macos-x64 --out-path dist",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64 --out-path dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "author": "暮雨",
  "license": "MIT"
}
